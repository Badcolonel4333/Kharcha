{
  "id": "/",
  "name": "Kharcha – Expense Tracker",
  "short_name": "Kharcha",
  "description": "Track daily expenses, see charts and export to Excel",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add",
      "description": "Log a new expense",
      "url": "./?a=add",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Charts",
      "short_name": "Charts",
      "description": "See spending charts",
      "url": "./?t=cats",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings & Excel export",
      "short_name": "Export",
      "description": "Export to Excel or manage categories",
      "url": "./?t=set",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "name": "Expense sheet",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+kharcha",
      "url": "./?q=%s"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "note_taking": {
    "new_note_url": "./?a=add"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "scope_extensions": []
}